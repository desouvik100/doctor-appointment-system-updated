# HealthSync Production Environment
# CRITICAL: This is for PRODUCTION deployment only

# ── Production MongoDB (High Performance) ─────────────────────────────────
# Use your production MongoDB URI here
MONGODB_URI=mongodb+srv://username:password@healthsync-production.mongodb.net/healthsync_production?retryWrites=true&w=majority

# ── Core Production Settings ──────────────────────────────────────────────
NODE_ENV=production
PERFORMANCE_TEST=false
USE_RAZORPAY_PAYMENTS=true

# ── JWT (Generate strong production secret) ────────────────────────────────
JWT_SECRET=your_super_strong_production_jwt_secret_minimum_64_characters_here

# ── Server Configuration ──────────────────────────────────────────────────
PORT=5005
BACKEND_URL=https://your-healthsync-api.com
FRONTEND_URL=https://your-healthsync-app.com
CORS_ORIGIN=https://your-healthsync-app.com

# ── Production Payments (LIVE) ────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_your_production_key
RAZORPAY_KEY_SECRET=your_production_secret
RAZORPAY_MODE=live
CURRENCY=INR
PLATFORM_FEE_PERCENTAGE=5
GST_PERCENTAGE=18

# ── Production Email Configuration ────────────────────────────────────────
EMAIL_USER=noreply@yourhealthsync.com
EMAIL_PASS=your_production_app_password
ADMIN_EMAIL=admin@yourhealthsync.com
RESEND_API_KEY=re_your_production_resend_key
RESEND_FROM_EMAIL=HealthSync <noreply@yourhealthsync.com>

# ── Production AI Services ────────────────────────────────────────────────
OPENAI_API_KEY=sk-your_production_openai_key
GEMINI_API_KEY=your_production_gemini_key
AI_PROVIDER=gemini

# ── Production Google Services ────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_production_google_client_id.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_production_google_secret
GOOGLE_REDIRECT_URI=https://your-healthsync-api.com/api/google/callback
GOOGLE_REFRESH_TOKEN=your_production_refresh_token

# ── Production Communications ─────────────────────────────────────────────
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=your_production_msg91_key
MSG91_SENDER_ID=HLTHSN
TWILIO_ACCOUNT_SID=ACyour_production_twilio_sid
TWILIO_AUTH_TOKEN=your_production_twilio_token
TWILIO_PHONE_NUMBER=+1your_production_number
TWILIO_WHATSAPP_NUMBER=+1your_production_whatsapp

WHATSAPP_PHONE_NUMBER_ID=your_production_phone_id
WHATSAPP_ACCESS_TOKEN=your_production_whatsapp_token
WHATSAPP_BUSINESS_ACCOUNT_ID=your_production_business_id
WHATSAPP_VERIFY_TOKEN=your_production_verify_token

# ── Production File Storage ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_production_cloud_name
CLOUDINARY_API_KEY=your_production_api_key
CLOUDINARY_API_SECRET=your_production_api_secret

# ── Production Redis (Recommended) ────────────────────────────────────────
REDIS_URL=redis://your-production-redis-url:6379

# ── Production Monitoring ─────────────────────────────────────────────────
NEW_RELIC_LICENSE_KEY=your_newrelic_key
NEW_RELIC_APP_NAME=HealthSync-Production
SENTRY_DSN=https://your-sentry-dsn

# ── Timezone ───────────────────────────────────────────────────────────────
TIMEZONE=Asia/Kolkata