# HealthSync Performance Test Environment
# Copy to .env and fill in values — NEVER commit .env with real credentials

# Target server
BASE_URL=http://localhost:5005

# Test mode: true = bypass real email sending
TEST_MODE=true

# Test credentials (use dedicated test accounts — never production accounts)
ADMIN_EMAIL=admin@healthsync.test
ADMIN_PASSWORD=Admin@123456
DOCTOR_EMAIL=doctor@healthsync.test
DOCTOR_PASSWORD=Doctor@123456
STAFF_EMAIL=staff@healthsync.test
STAFF_PASSWORD=Staff@123456

# Scale parameters
MAX_USERS=10000
RAMP_TIME=2m
DURATION=10m

# Output
VERBOSE=false
